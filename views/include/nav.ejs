<header>
    <div class="logo">
        <img class="logo-img" src="/favicon/logo.png">
    </div>

    <nav>
        <a href="/">Home</a>

        <% if (isAuthenticated) { %>
            <a href="/report">Report Case</a>
            <a href="/account/<%= user.username %>">Account</a>
        <% } else { %>
            <a href="/login">Login</a>
        <% } %>

        <a href="/about">About</a>
        <a href="/technologies">Technologies</a>
        <!-- <a href="/contact-us">Contact Us</a> -->
        <% if (isAuthenticated) { %>
            <form action="/logout" method="POST">
                <button>Logout</button>
            </form>
        <% }  %>
    </nav>

    <!-- Hamburger Icon for smaller screens -->
    <div class="hamburger" onclick="toggleMenu()">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
    </div>

    <!-- Dropdown menu for mobile navigation -->
    <div class="nav-dropdown" id="navDropdown">
        <a href="/">Home</a>

        <% if (isAuthenticated) { %>
            <a href="/report">Report Case</a>
            <a href="/account/<%= user.username %>">Account</a>
        <% } else { %>
            <a href="/login">Login</a>
        <% } %>

        <a href="/about">About</a>
        <a href="/technologies">Technologies</a>
        <!-- <a href="/contact-us">Contact Us</a> -->
        <% if (isAuthenticated) { %>
            <form action="/logout" method="POST">
                <button>Logout</button>
            </form>
        <% }  %>
    </div>
</header>