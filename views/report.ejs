<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head") %>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700&family=Roboto:wght@400;700&display=swap" rel="stylesheet" />

    <link href="/styles/common.css" rel="stylesheet">
    <link href="/styles/report.css" rel="stylesheet">
    <script src="/scripts/navbar.js" defer></script>
    <title>Report Case</title>
</head>
<body>
    <%- include("include/nav") %>
    <div class="main-container">
        <div class="report-form">
            <form action="/report" method="POST" enctype="multipart/form-data">
                <section class="report-section">
                    <h2>Report Case</h2>
                    <p class="description">Fill information about the person!</p>

                    <fieldset>
                        <p class="question-label">Person Status<span class="required">*</span></p>
                        <div class="radio-group">
                            <input type="radio" name="personStatus" value="foundPerson" id="foundPerson" required> 
                            <label for="foundPerson">Found Person</label> 
                    
                            <input type="radio" name="personStatus" value="missingPerson" id="missingPerson" required> 
                            <label for="missingPerson">Missing Person</label> 
                        </div>
                    </fieldset>

                    <div class="form-group">
                        <label for="fullname">Full Name<span class="required">*</span></label>
                        <input type="text" id="fullname" name="fullname" required>
                    </div>

                    <div class="form-group">
                        <label for="age">Approximate Age<span class="required">*</span></label>
                        <input type="number" id="age" name="age" required>
                    </div>

                    <fieldset>
                        <p class="question-label">Gender<span class="required">*</span></p>
                        <div class="radio-group">
                            <input type="radio" name="gender" value="male" id="male" required> 
                            <label for="male">Male</label> 
                    
                            <input type="radio" name="gender" value="female" id="female" required> 
                            <label for="female">Female</label> 

                            <input type="radio" name="gender" value="other" id="other" required> 
                            <label for="other">Other</label> 
                        </div>
                    </fieldset>

                    <div class="form-group">
                        <label for="lastSeen">Last Seen<span class="required">*</span></label>
                        <textarea id="lastSeen" name="lastSeen" rows="3" placeholder="Last Seen Location (City, Area)" required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="additionalDetails">Additional Details<span class="required">*</span></label>
                        <textarea id="additionalDetails" name="additionalDetails" rows="3" placeholder="Details like birthmarks, scars, tattoos, height, weight, blood group" required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="image">Person Image<span class="required">*</span></label>
                        <input type="file" id="image" name="image" required accept="image/*">
                    </div>
                </section>

                <section class="report-section">
                    <h2>Contact Information</h2>
                    <p class="description">To connect if any match is found!</p>

                    <div class="form-group">
                        <label for="email">Email Address<span class="required">*</span></label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="form-group">
                        <label for="contactNumber">Contact Number<span class="required">*</span></label>
                        <input type="tel" id="contactNumber" name="contactNumber" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="permanentAddress">Permanent Address<span class="required">*</span></label>
                        <textarea id="permanentAddress" name="permanentAddress" rows="3" placeholder="Your Permanent Address" required></textarea>
                    </div>

                    <button type="submit" class="submit-button">Submit Report</button>
                </section>
            </form>
        </div>
    </div>
</body>
</html>
