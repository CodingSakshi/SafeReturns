<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head", { title: 'Report' }) %>
    
    <link href="/styles/report.css" rel="stylesheet">
    <script src="/scripts/report.js" defer></script>
</head>
<body>
    <%- include("include/nav") %>
    <div class="main-container">
        <div class="report-form">
            <form action="/report" method="POST" enctype="multipart/form-data">
                <section class="report-section">
                    <h2>Report a Case</h2>
                    <p class="description">Please provide complete information about the individual, along with a clear image for identification purposes.</p>

                    <input type="hidden" id="matchedWith" name="matchedWith" value=""> <!-- Hidden field to store matched ID -->
                    
                    <fieldset>
                        <p class="question-label">Person Status<span class="required">*</span></p>
                        <div class="radio-group">
                            <input type="radio" name="personStatus" value="Found Person" id="foundPerson" required> 
                            <label for="foundPerson">Found Person</label> 
                    
                            <input type="radio" name="personStatus" value="Missing Person" id="missingPerson" required> 
                            <label for="missingPerson">Missing Person</label> 
                        </div>
                    </fieldset>

                    <div class="form-group">
                        <label for="fullname">Full Name<span class="required">*</span></label>
                        <input type="text" id="fullname" name="fullname" required>
                    </div>

                    <div class="form-group">
                        <label for="age">Approximate Age<span class="required">*</span></label>
                        <input type="number" id="age" name="age" min="0" required>
                    </div>

                    <fieldset>
                        <p class="question-label">Gender<span class="required">*</span></p>
                        <div class="radio-group">
                            <input type="radio" name="gender" value="Male" id="male" required> 
                            <label for="male">Male</label> 
                    
                            <input type="radio" name="gender" value="Female" id="female" required> 
                            <label for="female">Female</label> 

                            <input type="radio" name="gender" value="Other" id="other" required> 
                            <label for="other">Other</label> 
                        </div>
                    </fieldset>

                    <!-- <div class="form-group">
                        <label for="lastSeen">Last Seen Location<span class="required">*</span></label>
                        <textarea id="lastSeen" name="lastSeen" rows="3" placeholder="City, Area, or any significant landmarks" required></textarea>
                    </div> -->

                    <div class="form-group">
                        <label for="additionalDetails">Additional Identifying Information<span class="required">*</span></label>
                        <textarea id="additionalDetails" name="additionalDetails" rows="3" placeholder="Physical traits such as birthmarks, scars, tattoos, height, weight, blood group, etc." required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="image">Upload Image of the Person<span class="required">*</span><span style="font-size: 13px;"> (Image verification is required before submission)</span></label>
                        <p id="warningMessage"></p>
                        <input type="file" id="image" name="image" required accept="image/*">
                        <button type="button" id="verifyButton">Verify Image</button>
                    </div>

                </section>

                <section class="report-section">
                    <h2>Contact Information</h2>
                    <p class="description">Your contact information will be shared with the matching profile for facilitating communication.</p>

                    <div class="form-group">
                        <label for="email">Email Address<span class="required">*</span></label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="form-group">
                        <label for="contactNumber">Contact Number<span class="required">*</span></label>
                        <input type="tel" id="contactNumber" name="contactNumber" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="permanentAddress">Permanent Address<span class="required">*</span></label>
                        <textarea id="permanentAddress" name="permanentAddress" rows="3" placeholder="Your full address" required></textarea>
                    </div>

                    <button type="submit" id="submitButton" disabled>Submit Report</button>
                </section>
            </form>
        </div>
    </div>
</body>
</html>
