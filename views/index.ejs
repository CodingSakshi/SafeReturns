<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head", { title: 'Safe Returns' }) %>
    
    <link href="/styles/styles.css" rel="stylesheet">
</head>
<body>
    <%- include("include/nav") %>

    <div class="hero">
        <img class="hero-img" src="/favicon/hero.png">
        <div class="hero-content">
            <h1>SafeReturns</h1>
            <h3>Together, We Can Bring Them Back</h3>
            <p>SafeReturns empowers communities, NGOs, and police stations with an easy-to-use platform for finding and matching missing persons. Leveraging age-progressive facial recognition, we help locate individuals, even when years have passed. Your participation can change lives—join the effort to bring families back together.</p>

            <% if (isAuthenticated) { %>
                <a href="/report">Get Started ></a>
            <% } else { %>
                <a href="/signup" class="">Get Started ></a>
            <% } %>
    
        </div>
    </div>

    <footer class="footer">
        <div class="custom-hr"></div>

        <div class="footer-container">
            <div class="footer-logo">
                <img class="logo-img" src="/favicon/logo.png">
                <p>Together We Can Bring Them Back</p> <!-- Replace with your tagline -->
            </div>
            <div class="footer-links">
                <h3>COMPANY</h3>
                <ul>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/technologies">Technologies</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h3>RESOURCES</h3>
                <ul>
                    <li><a href="/">Blog</a></li>
                    <li><a href="/">Documentation</a></li>
                    <li><a href="/">FAQ</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h3>LEGAL</h3>
                <ul>
                    <li><a href="/terms-and-conditions">Terms of Service</a></li>
                    <li><a href="/terms-and-conditions">Privacy Policy</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2023 SafeReturns. All rights reserved.</p>
        </div>
    </footer>
    
    
</body>
</html>
